# RESCUENET-X ENVIRONMENT CONFIGURATION
# =====================================

# 1. Google Gemini API (for zero-latency cloud AI entity & severity extraction)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# 2. Google Maps API (for high-fidelity GIS satellite and tactical map projection)
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# 3. Mapbox GL JS (optional vector GIS mapping)
# Get a free public token at: https://mapbox.com/
MAPBOX_ACCESS_TOKEN=
VITE_MAPBOX_TOKEN=

# 3. Twilio Telephony (for live 2G/GSM voice calls via IVR webhook)
# Get credentials at: https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# 4. Local Ollama & Whisper (Offline Fallbacks - local dev only, not used on Render)
OLLAMA_ENDPOINT=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3
WHISPER_MODEL=base

# 5. Server Host & Port
HOST=0.0.0.0
PORT=8000
DEBUG=True
